{
  "name": "company-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:website": "node scripts/run-surface.mjs website dev",
    "dev:portal": "node scripts/run-surface.mjs portal dev",
    "dev:both": "node scripts/run-both-surfaces.mjs",
    "build": "next build",
    "build:website": "node scripts/run-surface.mjs website build",
    "build:portal": "node scripts/run-surface.mjs portal build",
    "start": "next start",
    "start:website": "node scripts/run-surface.mjs website start",
    "start:portal": "node scripts/run-surface.mjs portal start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:deploy": "prisma migrate deploy",
    "db:local": "node scripts/local-db.mjs",
    "postinstall": "prisma generate",
    "package:deploy": "node scripts/package-deploy.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "docx": "^9.7.2",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "next": "16.3.6",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
