# Local: run `npm run db:local` in a separate terminal and leave it running.
# Neon (production): DATABASE_URL = pooled connection string, DIRECT_URL = direct (non-pooler) string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sitesite"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/sitesite"
APP_SURFACE=
PROTOTYPE_ADMIN_EMAIL=
PROTOTYPE_ADMIN_PASSWORD=
PROTOTYPE_SESSION_SECRET=
PUBLIC_SITE_URL=http://localhost:3002
STAFF_PORTAL_URL=http://localhost:3001
